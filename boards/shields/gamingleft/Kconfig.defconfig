
if SHIELD_gamingleft_LEFT

config ZMK_KEYBOARD_NAME
    default "gaming-left"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif # SHIELD_gamingleft_LEFT

if SHIELD_gamingleft_LEFT || SHIELD_gamingleft_RIGHT

config ZMK_SPLIT
    default y

endif # SHIELD_gamingleft_LEFT || SHIELD_gamingleft_RIGHT
